# ReNamioos — variables d'environnement (reecriture Bun/TS)
# Copier en .env et remplir. NE JAMAIS committer le .env reel.

# --- Discord ---
# Token du bot (Discord Developer Portal > Bot > Reset Token). PLACEHOLDER :
DISCORD_TOKEN=your-discord-bot-token
# Application ID (Discord Developer Portal > General Information). PLACEHOLDER :
DISCORD_APPLICATION_ID=your-application-id
# Optionnel : ID de guild pour un deploiement de commandes instantane en dev.
# Laisser vide pour un deploiement global (jusqu'a 1h de propagation).
DISCORD_GUILD_ID=

# --- API HTTP (Fastify) ---
# Port distinct du monitoring (8099) et du template (3001) pour eviter les collisions.
PORT=8199
HOST=0.0.0.0

# --- Environnement ---
# development | production | test
NODE_ENV=development

# --- Auto-rename (B6, ADR-0004) ---
# Chemin du mapping roleId -> styleName, charge et valide au boot.
# Defaut : auto-rename.json a la racine. Exemple : auto-rename.example.json
AUTO_RENAME_CONFIG_PATH=auto-rename.json

# --- Persistance Neon (B8, ADR-0005) ---
# OPTIONNELLE. Absente => mode FICHIER (dev) : auto-rename lu depuis auto-rename.json,
# ecriture via /auto-rename interdite. Presente => mode NEON : config auto-rename PAR
# SERVEUR, modifiable depuis Discord (avec fallback lecture fichier en transition).
# En prod, cette URL vit dans .env.production chiffre dotenvx (jamais en clair, D7).
# PLACEHOLDER :
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# --- Durcissement API (ADR-0006, findings #22/#23/#24) ---
# STATS_TOKEN : token Bearer protegeant GET /stats (CWE-306). Absent => /stats ouvert
# (mode dev). En prod, le RENSEIGNER et le fournir a bdf-monitor (header
# "Authorization: Bearer <token>"). /health reste TOUJOURS public (contrat monitoring).
STATS_TOKEN=
# CORS_ORIGINS : origines autorisees, separees par des virgules. Vide => CORS desactive
# (aucune origine cross-site), au lieu de refleter n'importe quelle origine.
CORS_ORIGINS=
# Rate limit par IP (CWE-770). Defauts surs si absents.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
