# Production, a chiffrer par dotenvx (ADR-0005, DECISIONS.md D7).
# Remplir puis chiffrer, dans bots/ReNamioos :
#   bunx dotenvx set DISCORD_TOKEN <token> -f .env.production
#   bunx dotenvx set DISCORD_APPLICATION_ID <id> -f .env.production
#   bunx dotenvx set DATABASE_URL "<url pooler du projet Neon ReNamioos>" -f .env.production
# (dotenvx set chiffre automatiquement ; la cle privee atterrit dans .env.keys,
#  gitignore, a stocker dans Bitwarden Secrets Manager puis dans l'app Dokploy.)
# DATABASE_URL : console.neon.tech, projet ReNamioos (square-frost-15330405), branche main.
DISCORD_TOKEN=A_REMPLIR
DISCORD_APPLICATION_ID=A_REMPLIR
DATABASE_URL=A_REMPLIR
PORT=8199
HOST=0.0.0.0
NODE_ENV=production
